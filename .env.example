# Sao chép thành .env rồi sửa giá trị. KHÔNG commit file .env.
NODE_ENV=development
PORT=3000

# Local: dùng MySQL từ docker-compose.yml
# Render + Aiven: dán Service URI của Aiven (có sẵn ?ssl-mode=REQUIRED) — xem docs/RENDER_SETUP.md
DATABASE_URL=mysql://inventory:inventory@localhost:3306/inventory

# SSL cho DB bên ngoài. Tự bật nếu DATABASE_URL có ?ssl-mode=REQUIRED.
# DB_SSL=true
# Nội dung file ca.pem của Aiven, để xác minh server (khuyến nghị ở production)
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-local-dev
JWT_EXPIRES_IN=1d

CORS_ORIGIN=*

# Mật khẩu tài khoản mẫu khi chạy npm run db:seed (bắt buộc đặt ở production)
# SEED_ADMIN_PASSWORD=
# SEED_STAFF_PASSWORD=
