# Sao chép thành .env rồi sửa giá trị. KHÔNG commit file .env.
NODE_ENV=development
PORT=3000

# Local: dùng MySQL từ docker-compose.yml
# Railway: đặt DATABASE_URL=${{MySQL.MYSQL_URL}} trong tab Variables của Node service
DATABASE_URL=mysql://inventory:inventory@localhost:3306/inventory

# Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-local-dev
JWT_EXPIRES_IN=1d

CORS_ORIGIN=*

# Mật khẩu tài khoản mẫu khi chạy npm run db:seed (bắt buộc đặt ở production)
# SEED_ADMIN_PASSWORD=
# SEED_STAFF_PASSWORD=
